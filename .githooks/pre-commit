#!/bin/sh
set -eu

# Git for Windows ships the shell used here; only Python and Git are needed.
if command -v py >/dev/null 2>&1; then
    exec py -3 tools/check_repository.py --staged
elif command -v python3 >/dev/null 2>&1; then
    exec python3 tools/check_repository.py --staged
elif command -v python >/dev/null 2>&1; then
    exec python tools/check_repository.py --staged
else
    echo 'Python 3.10+ is required. Update HANDOFF.md and run the repository checks.' >&2
    exit 1
fi
